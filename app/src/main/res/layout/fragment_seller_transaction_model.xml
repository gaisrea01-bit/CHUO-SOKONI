<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundLight">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvModelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Choose Model"
                android:textColor="@color/logo_navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select how your student product is sold"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <!-- Transaction Models Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTransactionModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RadioButton
                        android:id="@+id/rbDirectRetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:paddingVertical="8dp"
                        android:text="Direct Retail\nSell directly to customers"
                        android:textColor="@color/logo_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <RadioButton
                        android:id="@+id/rbWholesaleInvestor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingVertical="8dp"
                        android:text="Wholesale to Investor\nSell to investors (10% retail)"
                        android:textColor="@color/logo_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RadioGroup>
            </androidx.cardview.widget.CardView>

            <!-- Continue Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueModel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="Continue"
                android:textColor="@color/logo_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/logo_gold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
