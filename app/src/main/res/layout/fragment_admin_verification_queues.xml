<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundLight"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAdminVerifTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Verification Queues"
        android:textColor="@color/logo_navy"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAdminVerifSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Pending seller &amp; investor documents"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewVerificationQueue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
