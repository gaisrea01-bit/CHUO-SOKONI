<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundLight"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp">

        <!-- Product Image Viewer Card with Vector Placeholder -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProdImage"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/backgroundLight"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ivProdDetailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/baseline_insert_photo_24"
                app:tint="@color/logo_navy" />
        </androidx.cardview.widget.CardView>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tvProdDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Running Shoes"
            android:textColor="@color/logo_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvProdPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TZS 45,000"
            android:textColor="@color/logo_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Ratings & Reviews info -->
        <LinearLayout
            android:id="@+id/layoutRatings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/baseline_star_rate_24"
                app:tint="@color/logo_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.5 (120)"
                android:textColor="@color/logo_navy"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Product Description -->
        <TextView
            android:id="@+id/tvProdDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Comfortable and durable running shoes designed for everyday student campus use and athletic activities."
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Add to Cart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Add to Cart"
            android:textColor="@color/logo_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/logo_gold"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
