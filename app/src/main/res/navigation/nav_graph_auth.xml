<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.chuosokonifrontend.ui.auth.SplashFragment"
        android:label="Splash / Landing">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splash_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.chuosokonifrontend.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_passwordRecovery"
            app:destination="@id/passwordRecoveryFragment" />
        <action
            android:id="@+id/action_login_to_accountStatus"
            app:destination="@id/accountStatusFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.chuosokonifrontend.ui.auth.RegisterFragment"
        android:label="Registration">
        <action
            android:id="@+id/action_register_to_referralCode"
            app:destination="@id/referralCodeFragment" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/referralCodeFragment"
        android:name="com.chuosokonifrontend.ui.auth.ReferralCodeFragment"
        android:label="Referral Code Entry">
        <action
            android:id="@+id/action_referralCode_to_accountStatus"
            app:destination="@id/accountStatusFragment" />
    </fragment>

    <fragment
        android:id="@+id/passwordRecoveryFragment"
        android:name="com.chuosokonifrontend.ui.auth.PasswordRecoveryFragment"
        android:label="Password Recovery">
        <action
            android:id="@+id/action_passwordRecovery_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountStatusFragment"
        android:name="com.chuosokonifrontend.ui.auth.AccountStatusFragment"
        android:label="Account Status">
        <action
            android:id="@+id/action_accountStatus_to_onboarding"
            app:destination="@id/onboardingFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.chuosokonifrontend.ui.auth.OnboardingFragment"
        android:label="Onboarding / Welcome" />

</navigation>
