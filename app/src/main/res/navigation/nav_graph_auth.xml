<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.chuosokonifrontend.ui.auth.SplashFragment"
        android:label="Splash / Landing">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splash_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.chuosokonifrontend.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_passwordRecovery"
            app:destination="@id/passwordRecoveryFragment" />
        <action
            android:id="@+id/action_login_to_customerDash"
            app:destination="@id/customerDashboardFragment"
            app:popUpTo="@id/nav_graph_auth"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.chuosokonifrontend.ui.auth.RegisterFragment"
        android:label="Registration">
        <action
            android:id="@+id/action_register_to_referralCode"
            app:destination="@id/referralCodeFragment" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/referralCodeFragment"
        android:name="com.chuosokonifrontend.ui.auth.ReferralCodeFragment"
        android:label="Referral Code Entry">
        <action
            android:id="@+id/action_referralCode_to_accountStatus"
            app:destination="@id/accountStatusFragment" />
    </fragment>

    <fragment
        android:id="@+id/passwordRecoveryFragment"
        android:name="com.chuosokonifrontend.ui.auth.PasswordRecoveryFragment"
        android:label="Password Recovery">
        <action
            android:id="@+id/action_passwordRecovery_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountStatusFragment"
        android:name="com.chuosokonifrontend.ui.auth.AccountStatusFragment"
        android:label="Account Status">
        <action
            android:id="@+id/action_accountStatus_to_onboarding"
            app:destination="@id/onboardingFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.chuosokonifrontend.ui.auth.OnboardingFragment"
        android:label="Onboarding / Welcome">
        <action
            android:id="@+id/action_onboarding_to_customerDash"
            app:destination="@id/customerDashboardFragment"
            app:popUpTo="@id/nav_graph_auth"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Dashboard & Main Destinations -->
    <fragment
        android:id="@+id/customerDashboardFragment"
        android:name="com.chuosokonifrontend.ui.customer.CustomerDashboardFragment"
        android:label="Home">
        <deepLink app:uri="chuosokoni://customer/dashboard" />
    </fragment>

    <fragment
        android:id="@+id/sellerDashboardFragment"
        android:name="com.chuosokonifrontend.ui.seller.SellerDashboardFragment"
        android:label="Seller Dashboard">
        <deepLink app:uri="chuosokoni://seller/dashboard" />
    </fragment>

    <fragment
        android:id="@+id/investorDashboardFragment"
        android:name="com.chuosokonifrontend.ui.investor.InvestorDashboardFragment"
        android:label="Investor Dashboard">
        <deepLink app:uri="chuosokoni://investor/dashboard" />
    </fragment>

    <fragment
        android:id="@+id/agentDashboardFragment"
        android:name="com.chuosokonifrontend.ui.agent.AgentDashboardFragment"
        android:label="Agent Dashboard">
        <deepLink app:uri="chuosokoni://agent/dashboard" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.chuosokonifrontend.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard">
        <deepLink app:uri="chuosokoni://admin/dashboard" />
    </fragment>

    <fragment
        android:id="@+id/browseSearchFragment"
        android:name="com.chuosokonifrontend.ui.customer.BrowseSearchFragment"
        android:label="Browse" />

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.chuosokonifrontend.ui.customer.CartFragment"
        android:label="Cart" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.chuosokonifrontend.ui.auth.NotificationsFragment"
        android:label="Notifications" />

    <fragment
        android:id="@+id/profileSettingsFragment"
        android:name="com.chuosokonifrontend.ui.auth.ProfileSettingsFragment"
        android:label="Profile &amp; Settings" />

</navigation>
